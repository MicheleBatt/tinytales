<!DOCTYPE html>
<html lang="it">
  <head>
    <title><%= content_for(:title) || "TinyTales" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Le stesse favicon del sito della scuola. %>
    <%= favicon_link_tag "favicon.ico", type: "image/x-icon", sizes: "any" %>
    <%= favicon_link_tag "favicon-32x32.png", type: "image/png", sizes: "32x32" %>
    <%= favicon_link_tag "favicon-16x16.png", type: "image/png", sizes: "16x16" %>
    <%= favicon_link_tag "apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="lightbox" data-action="click->lightbox#open">
    <header class="testata">
      <div class="testata-interno">
        <%= link_to root_path, class: "marchio" do %>
          <%= image_tag "logo_scuola.jpg", alt: "", class: "marchio-logo" %>
          <span>
            <span class="marchio-nome">TinyTales</span>
            <span class="marchio-sotto">Scuola dell'Infanzia Santa Maria Goretti · Creola</span>
          </span>
        <% end %>
        <nav class="link-pagine">
          <%= link_to "Checklist ↗", checklist_url, class: "link-pagina", target: "_blank", rel: "noopener",
                      title: "Lo stato dei lavori su sito e pagine social (pagina privata su claude.ai)" %>
          <% SocialPage.by_name.each do |page| %>
            <%= link_to "#{page.platform_label} ↗", page.url, class: "link-pagina", target: "_blank", rel: "noopener", title: page.name %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="contenuto <%= 'contenuto-largo' if content_for?(:wide) %>">
      <% if notice %><p class="avviso avviso-ok" role="status"><%= notice %></p><% end %>
      <% if alert %><p class="avviso avviso-ritardo" role="alert"><%= alert %></p><% end %>
      <% Array(flash[:warnings]).each do |warning| %><p class="avviso avviso-info" role="status"><%= warning %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
