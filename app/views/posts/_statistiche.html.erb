<%# Visualizzazioni e persone raggiunte di un post pubblicato, scritte per esteso (pagina del post e popup del calendario):
    due riquadri con icona, totale dalla pubblicazione e aumento dall'ultimo giorno letto prima.
    Locals: post, points ([PostStats::Point], vuoto se non ci sono letture). %>
<% if PostStats.shown?(post) %>
  <div class="statistiche" id="statistiche-<%= post.id %>">
    <% if (totals = PostStats.totals_of(points.last)) %>
      <% { views: "VISUALIZZAZIONI", reach: "PERSONE RAGGIUNTE" }.each do |kind, label| %>
        <div class="statistica">
          <span class="statistica-icona"><%= stats_icon(kind) %></span>
          <span class="statistica-dati">
            <span class="statistica-etichetta"><%= label %></span>
            <strong class="statistica-numero"><%= stats_number(totals.public_send(kind)) %></strong>
            <% if (change = PostStats.change(points, kind)) %>
              <span class="statistica-variazione"><b>+<%= stats_number(change.first) %></b> dal <%= l(change.last, format: "%-d %b") %></span>
            <% end %>
          </span>
        </div>
      <% end %>
      <span class="statistiche-nota">Totali dalla pubblicazione<br>lettura del <%= l(totals.measured_at, format: :short) %></span>
    <% else %>
      <span class="statistiche-nota">Visualizzazioni e persone raggiunte: in arrivo dai social…</span>
    <% end %>
  </div>
<% end %>
