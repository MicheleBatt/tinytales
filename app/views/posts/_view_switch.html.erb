<%# Le tre viste dell'elenco. Sono link (?vista=…); tra lista e griglia il controller view-switch
    cambia vista senza ricaricare la pagina. %>
<nav class="scelta-vista" aria-label="Vista dell'elenco">
  <% [ [ "lista", "Lista" ], [ "griglia", "Griglia" ], [ "calendario", "Calendario" ] ].each do |view, label| %>
    <%= link_to posts_path(request.query_parameters.except("vista", "mese").merge(vista: view)),
                class: "icona-vista", title: "Vista a #{label.downcase}", "aria-pressed": (@view == view).to_s,
                data: { view: view, view_switch_target: "button", action: "view-switch#show" } do %>
      <% case view %>
      <% when "lista" %>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 3.5h12M2 8h12M2 12.5h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <% when "griglia" %>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1" fill="currentColor"/><rect x="9" y="2" width="5" height="5" rx="1" fill="currentColor"/><rect x="2" y="9" width="5" height="5" rx="1" fill="currentColor"/><rect x="9" y="9" width="5" height="5" rx="1" fill="currentColor"/></svg>
      <% else %>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2 6.5h12M5.5 1.8v2.4M10.5 1.8v2.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="4.5" y="8.5" width="2" height="2" fill="currentColor"/><rect x="9" y="8.5" width="2" height="2" fill="currentColor"/></svg>
      <% end %>
      <span><%= label %></span>
    <% end %>
  <% end %>
</nav>
