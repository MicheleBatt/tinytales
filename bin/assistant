#!/usr/bin/env ruby
# Comandi per l'assistente della chat, avviabili da qualsiasi cartella:
#   bin/assistant posts                       elenco dei post (sola lettura)
#   bin/assistant post 12                     un post completo, con i percorsi dei file (sola lettura)
#   bin/assistant video RICETTA.json          monta un video dalla ricetta (vedi lib/assistant/video.rb)
#   bin/assistant fotogrammi VIDEO.mp4 [N]    un foglio con N fotogrammi del video (9 se non indicato)
#   bin/assistant fotogramma VIDEO.mp4 SEC    un fotogramma a piena risoluzione
#   bin/assistant musica                      i brani della musicoteca (tabella music_tracks), con la loro scheda
#   bin/assistant facebook                    foto e video pubblicati sulla pagina Facebook della scuola
#   bin/assistant facebook anteprime CARTELLA ID [ID…]   un foglio di anteprime numerate (fino a 12)
#   bin/assistant facebook scarica CARTELLA ID [ID…]     scarica foto o video nella cartella di lavoro (fino a 10)
# I file della ricetta e i video devono stare nella cartella di lavoro della chat, dove finiscono anche i risultati.
USAGE = "Uso: bin/assistant posts | post ID | video RICETTA.json | fotogrammi VIDEO.mp4 [N] | " \
        "fotogramma VIDEO.mp4 SECONDI | musica | facebook [anteprime|scarica CARTELLA ID…]".freeze
command, *args = ARGV

case command
when "posts", "post", "musica", "video"
  # Questi comandi usano il database: passano da Rails.
  abort USAGE unless args.size == (command == "posts" || command == "musica" ? 0 : 1)
  Dir.chdir(File.expand_path("..", __dir__))
  ENV.delete("DATABASE")
  rails = [ "bin/rails", "assistant:#{command}" ]
  rails << "ID=#{args.first}" if command == "post"
  rails << "RICETTA=#{args.first}" if command == "video"
  exec(*rails)
when "facebook"
  # Gli id sono solo numeri: niente altro passa a Rails.
  action, folder, *ids = args
  valid = args.empty? ||
          (%w[anteprime scarica].include?(action) && folder.to_s.start_with?("/") && ids.any? &&
           ids.all? { |id| id.match?(/\A\d{5,30}\z/) })
  abort USAGE unless valid
  Dir.chdir(File.expand_path("..", __dir__))
  ENV.delete("DATABASE")
  rails = [ "bin/rails", "assistant:facebook" ]
  rails += [ "AZIONE=#{action}", "CARTELLA=#{folder}", "IDS=#{ids.join(',')}" ] if action
  exec(*rails)
when "fotogrammi", "fotogramma"
  require_relative "../lib/assistant/video"
  begin
    puts case command
         when "fotogrammi"
           abort USAGE unless args.size.between?(1, 2)
           Assistant::Video.contact_sheet(args[0], args[1] || 9)
         else
           abort USAGE unless args.size == 2
           Assistant::Video.frame(args[0], args[1])
         end
  rescue Assistant::Video::Error => e
    abort "Errore: #{e.message}"
  end
else
  abort USAGE
end
